<div id="share-wislist-modal" class="wishlist-modal modal fade" tabindex="-1" role="dialog" aria-labelledby="shareWishlistModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="shareWishlistModalTitle">{l s='Share wishlist' d='Modules.Blockwishlist.Shop'}</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="{l s='Close' d='Shop.Theme.Global'}">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div class="form-group form-group-lg">
          <label for="wishlist-share-url" class="form-control-label">{l s='Share link' d='Modules.Blockwishlist.Shop'}</label>
          <input type="text" id="wishlist-share-url" placeholder="{l s='Share link' d='Modules.Blockwishlist.Shop'}" class="form-control form-control-lg">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" data-dismiss="modal" class="modal-cancel btn btn-secondary">{l s='Cancel' d='Modules.Blockwishlist.Shop'}</button>
        <button type="button" class="btn btn-primary" id="wishlist-share-url-copy">{l s='Copy text' d='Modules.Blockwishlist.Shop'}</button>
      </div>
    </div>
  </div>
</div>
